--- /dev/null
+++ b/es-core/src/ThorCanvas.h
@@ -0,0 +1,16 @@
+#pragma once
+
+#include "renderers/Renderer.h"
+
+// The Thor canvas spans a hidden 1240-pixel margin, the 1920-pixel top display and the 1240-pixel lower display.
+// Popups sized from the whole canvas spill onto the lower display, so they measure themselves against the top display instead.
+namespace ThorCanvas
+{
+	inline bool active() { return Renderer::getScreenWidth() == 4400 && Renderer::getScreenHeight() == 1080; }
+
+	// The width a popup treats as the screen; every other device keeps its real screen width.
+	inline float width() { return active() ? 1920.0f : (float)Renderer::getScreenWidth(); }
+
+	// The x position where that width begins, so edge-anchored popups stay on the top display.
+	inline float left() { return active() ? 1240.0f : 0.0f; }
+}
