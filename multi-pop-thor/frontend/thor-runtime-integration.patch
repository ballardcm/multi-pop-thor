+++ b/es-app/src/ThorIntegration.h
@@ -0,0 +1,48 @@
+#pragma once
+
+#include <fstream>
+#include <map>
+#include <string>
+
+// Multi Pop distributes its frontend without compiled-in service keys. The activation helper copies the stock
+// frontend's keys into this root-only file on each Thor, and these lookups read them when a request needs them.
+namespace ThorIntegration
+{
+	inline const std::string& get(const std::string& key)
+	{
+		static const std::map<std::string, std::string> values = []
+		{
+			std::map<std::string, std::string> parsed;
+			std::ifstream file("/storage/.config/multi-pop-thor/integration.env");
+			std::string line;
+			while (std::getline(file, line))
+			{
+				// Values contain '=' and '&', so only the first '=' separates the name.
+				auto split = line.find('=');
+				if (line.empty() || line[0] == '#' || split == std::string::npos)
+					continue;
+				parsed[line.substr(0, split)] = line.substr(split + 1);
+			}
+			return parsed;
+		}();
+
+		static const std::string empty;
+		auto it = values.find(key);
+		return it == values.cend() ? empty : it->second;
+	}
+
+	// A compile-time literal from a private build and a runtime value are both accepted, so features turn on only when a key exists.
+	inline bool present(const char* value) { return value != nullptr && *value != '\0'; }
+}
+
+#ifndef SCREENSCRAPER_DEV_LOGIN
+#define SCREENSCRAPER_DEV_LOGIN ThorIntegration::get("SCREENSCRAPER_DEV_LOGIN").c_str()
+#endif
+
+#ifndef GAMESDB_APIKEY
+#define GAMESDB_APIKEY ThorIntegration::get("GAMESDB_APIKEY").c_str()
+#endif
+
+#ifndef CHEEVOS_DEV_LOGIN
+#define CHEEVOS_DEV_LOGIN ThorIntegration::get("CHEEVOS_DEV_LOGIN").c_str()
+#endif
