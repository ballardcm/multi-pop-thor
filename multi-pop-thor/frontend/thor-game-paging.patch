@@ -0,0 +1,70 @@
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+// Pixel thresholds keep normal finger jitter from turning a tap into a swipe.
+class ThorTouchGesture
+{
+public:
+	void begin(int x, int y, uint32_t time)
+	{
+		mStartX = mAnchorX = x;
+		mStartY = y;
+		mTime = time;
+		mCancelled = false;
+		mMoved = false;
+	}
+
+	void cancel() { mCancelled = true; }
+
+	int move(int x, int y)
+	{
+		if (x < 3160 || x >= 4400 || y < 0 || y >= 1080)
+			cancel();
+		const int dx = x - mStartX;
+		const int dy = y - mStartY;
+		if (std::abs(dx) > 18 || std::abs(dy) > 18)
+			mMoved = true;
+		// Vertical movement must never launch an item or accidentally scroll sideways.
+		if (std::abs(dy) > 18 && std::abs(dy) >= std::abs(dx))
+			cancel();
+		if (mCancelled)
+			return 0;
+		const int steps = (mAnchorX - x) / 100;
+		mAnchorX -= steps * 100;
+		return steps;
+	}
+
+	bool tap(uint32_t time) const
+	{
+		return !mCancelled && !mMoved && uint32_t(time - mTime) <= 500;
+	}
+
+private:
+	int mStartX = 0, mStartY = 0, mAnchorX = 0;
+	uint32_t mTime = 0;
+	bool mCancelled = true, mMoved = false;
+};
+
+// Remember the rendered cards so taps follow their actual positions, scale, and draw order.
+class ThorTouchTargets
+{
+public:
+	void clear() { mCards.clear(); }
+	void add(int index, int x, int y, int width, int height)
+	{
+		mCards.push_back({index, x, y, width, height});
+	}
+	int hit(int x, int y) const
+	{
+		for (auto card = mCards.rbegin(); card != mCards.rend(); ++card)
+			if (x >= card->x && x < card->x + card->width && y >= card->y && y < card->y + card->height)
+				return card->index;
+		return -1;
+	}
+private:
+	struct Card { int index, x, y, width, height; };
+	std::vector<Card> mCards;
+};
