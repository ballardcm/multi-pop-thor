+bool ViewController::onMouseClick(int button, bool pressed, int x, int y)
+{
+	if (button != 1)
+		return false;
+	if (pressed)
+	{
+		cancelUpperTouch();
+		const bool wokeScreen = mWindow->cancelScreenSaver();
+		mTouchBackButton = mState.viewing == GAME_LIST && ThorTouchGesture::libraryBackHit(x, y);
+		const bool lowerPanel = x >= 3160;
+		mUpperTouch.begin(x, y, SDL_GetTicks(), lowerPanel ? 3160 : 1240, lowerPanel ? 4400 : 3160);
+		if (wokeScreen || mLockInput)
+			mUpperTouch.cancel();
+		mUpperTouchActive = true;
+		mWindow->setMouseCapture(this);
+	}
+	else if (mUpperTouchActive)
+	{
+		onMouseMove(x, y);
+		const bool back = mTouchBackButton;
+		const bool select = mUpperTouchActive && mUpperTouch.tap(SDL_GetTicks()) &&
+			(!back || ThorTouchGesture::libraryBackHit(x, y));
+		cancelUpperTouch();
+		// Confirm only after a stationary tap ends, so a swipe never becomes a game launch.
+		if (select)
+			sendUpperTouchInput(back ? BUTTON_BACK : BUTTON_OK);
+	}
+	return true;
+}
+
+void ViewController::onMouseMove(int x, int y)
+{
+	if (!mUpperTouchActive)
+		return;
+	if (mWindow->peekGui() != this || mLockInput || Settings::getInstance()->getBool("DisableTouchscreen"))
+	{
+		cancelUpperTouch();
+		return;
+	}
+	const int steps = mUpperTouch.move(x, y);
+	// Sliding off the header button cancels it without moving the game carousel.
+	if (mTouchBackButton)
+		return;
+	for (int step = 0; step < std::abs(steps); ++step)
+		sendUpperTouchInput(steps > 0 ? "right" : "left");
+}
