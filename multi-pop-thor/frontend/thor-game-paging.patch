+bool CarouselGameListView::input(InputConfig* config, Input input)
+{
+	const bool thorMultiPop = Renderer::getScreenWidth() == 4400 &&
+		Renderer::getScreenHeight() == 1080 &&
+		Settings::getInstance()->getString("ThemeSet") == "multi-pop-thor";
+	if (thorMultiPop)
+	{
+		// The saved controller configuration and SDL fallback name L1 and R1 differently, so both names must keep the same physical controls.
+		const bool pageLeft = config->isMappedTo("leftshoulder", input) || config->isMappedTo("pageup", input);
+		const bool pageRight = config->isMappedTo("rightshoulder", input) || config->isMappedTo("pagedown", input);
+		if (pageLeft || pageRight)
+		{
+			// Consume the normalized press and release before quick-system selection so a page always stays in the current game list.
+			if (input.value != 0 && mList.size() > 0)
+			{
+				mList.stopScrolling();
+				const int count = static_cast<int>(mList.size());
+				const int target = mList.getCursorIndex() + (pageRight ? 3 : -3);
+				mList.setCursorIndex(target < 0 ? 0 : (target >= count ? count - 1 : target));
+			}
+			return true;
+		}
+	}
+
+	return ISimpleGameListView::input(config, input);
 }
 
